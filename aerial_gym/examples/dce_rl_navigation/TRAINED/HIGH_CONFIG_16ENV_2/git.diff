+-                                
+-                            # Segmentation analysis (DCE method)
+-                            unique_segs = np.unique(seg_img)
+-                            logger.info(f"   Segmentation (raw): {len(unique_segs)} unique values, range {unique_segs.min():.1f} to {unique_segs.max():.1f}")
