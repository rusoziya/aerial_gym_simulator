+-        
+-        # Create combined image (side by side)
+-        h, w = depth_colored.shape[:2]
+-        combined = np.zeros((h, w * 2, 3), dtype=np.uint8)
+-        combined[:, :w] = depth_colored
+-        combined[:, w:] = seg_colored
+-        
+-        # Add labels
