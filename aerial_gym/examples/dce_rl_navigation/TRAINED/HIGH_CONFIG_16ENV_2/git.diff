+-            gate_pose,
+-            "gate",
+-            0,  # Collision group
+-            1   # Collision filter
+-        )
+-        self.gate_handles.append(gate_handle)
+-        
+-        # Note: Gate color is set in the URDF material properties
+-        # Isaac Gym will use the default material colors from the URDF
+-        
+-        print("✓ Environment created with gate!")
