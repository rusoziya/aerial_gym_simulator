<?xml version="1.0"?>
<robot name="gate_medium">

  <!-- Medium gate material (green color to distinguish from full gate) -->
  <material name="gate_medium_material">
    <color rgba="0.1 0.8 0.4 1.0"/>
  </material>

  <!-- The base of the gate, to which all other parts are connected. -->
  <link name="base_link"/>

  <!-- Left vertical post of the gate (0.7x scale) -->
  <link name="left_post">
    <visual>
      <origin xyz="0 0 0.875" rpy="0 0 0"/>
      <geometry>
        <!-- Scaled: 0.2*0.7 = 0.14, 2.5*0.7 = 1.75 -->
        <box size="0.14 0.14 1.75"/>
      </geometry>
      <material name="gate_medium_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.875" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 1.75"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7"/>
      <inertia ixx="1.4" ixy="0.0" ixz="0.0" iyy="1.4" iyz="0.0" izz="1.4"/>
    </inertial>
  </link>

  <!-- Connects the left post to the base (0.7x scale) -->
  <joint name="base_to_left_post" type="fixed">
    <parent link="base_link"/>
    <child link="left_post"/>
    <!-- Scaled: 1.25*0.7 = 0.875 -->
    <origin xyz="0 0.875 0" rpy="0 0 0"/>
  </joint>

  <!-- Right vertical post of the gate (0.7x scale) -->
  <link name="right_post">
    <visual>
      <origin xyz="0 0 0.875" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 1.75"/>
      </geometry>
      <material name="gate_medium_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.875" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 1.75"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7"/>
      <inertia ixx="1.4" ixy="0.0" ixz="0.0" iyy="1.4" iyz="0.0" izz="1.4"/>
    </inertial>
  </link>

  <!-- Connects the right post to the base (0.7x scale) -->
  <joint name="base_to_right_post" type="fixed">
    <parent link="base_link"/>
    <child link="right_post"/>
    <!-- Scaled: -1.25*0.7 = -0.875 -->
    <origin xyz="0 -0.875 0" rpy="0 0 0"/>
  </joint>

  <!-- Top horizontal bar of the gate (0.7x scale) -->
  <link name="top_bar">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Scaled: 0.2*0.7 = 0.14, 2.7*0.7 = 1.89 -->
        <box size="0.14 1.89 0.14"/>
      </geometry>
      <material name="gate_medium_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 1.89 0.14"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7"/>
      <inertia ixx="1.4" ixy="0.0" ixz="0.0" iyy="1.4" iyz="0.0" izz="1.4"/>
    </inertial>
  </link>

  <!-- Connects the top bar to the base (0.7x scale) -->
  <joint name="base_to_top_bar" type="fixed">
    <parent link="base_link"/>
    <child link="top_bar"/>
    <!-- Scaled: 2.4*0.7 = 1.68 -->
    <origin xyz="0 0 1.68" rpy="0 0 0"/>
  </joint>

  <!-- Bottom horizontal bar of the gate (0.7x scale) -->
  <link name="bottom_bar">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 1.89 0.14"/>
      </geometry>
      <material name="gate_medium_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 1.89 0.14"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7"/>
      <inertia ixx="1.4" ixy="0.0" ixz="0.0" iyy="1.4" iyz="0.0" izz="1.4"/>
    </inertial>
  </link>

  <!-- Connects the bottom bar to the base (0.7x scale) -->
  <joint name="base_to_bottom_bar" type="fixed">
    <parent link="base_link"/>
    <child link="bottom_bar"/>
    <!-- Scaled: 0.1*0.7 = 0.07 -->
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
  </joint>

</robot> 